{
  "info": {
    "_postman_id": "a9f6e2c1-artist-routes-2026",
    "name": "Chroma Garcia API - Artist Routes",
    "description": "Postman collection for public and admin Artist API routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "artistId",
      "value": ""
    },
    {
      "key": "artistSlug",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public Artist Routes",
      "item": [
        {
          "name": "Get All Artists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/artists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "artists"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Artist by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/artists/{{artistSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "artists",
                "{{artistSlug}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Artist Routes",
      "item": [
        {
          "name": "Create Artist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"juan-dela-cruz\",\n  \"name\": \"Juan Dela Cruz\",\n  \"artStyle\": \"Contemporary Abstract\",\n  \"medium\": \"Acrylic on Canvas\",\n  \"bio\": \"A contemporary artist exploring color, movement, and texture through abstract compositions.\",\n  \"palette\": [\n    \"#FF5733\",\n    \"#1E293B\",\n    \"#F8FAFC\"\n  ],\n  \"social\": {\n    \"instagram\": \"https://instagram.com/juandelacruz\",\n    \"facebook\": \"https://facebook.com/juandelacruz\",\n    \"website\": \"https://juandelacruz.com\"\n  },\n  \"portraitUrl\": \"https://example.com/juan-dela-cruz.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/artists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "artists"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Artist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"An updated biography for Juan Dela Cruz.\",\n  \"artStyle\": \"Contemporary Abstract Art\",\n  \"palette\": [\n    \"#FF5733\",\n    \"#1E293B\",\n    \"#F8FAFC\",\n    \"#EAB308\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/artists/{{artistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "artists",
                "{{artistId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Artist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/artists/{{artistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "artists",
                "{{artistId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}